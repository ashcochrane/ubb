{
  "name": "ubb-codegen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "contract:types": "openapi-typescript ../../openapi/v1.json -o src/generated/v1.d.ts",
    "typecheck": "pnpm contract:types && tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:update": "vitest run -u"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "eslint": "^9.39.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.0"
  }
}
