# A preview of one request, for reading: the method, the URL, the headers
# and the body. It is not the runnable file and carries no verdict: the
# header of the runnable file says whether the integration is ready.
# operation_id = "api_v1_metering_endpoints_record_usage"

POST $UBB_BASE_URL/api/v1/metering/usage
Authorization: Bearer $UBB_API_KEY
Content-Type: application/json

{
  "customer_id": $customer_id,
  "idempotency_key": $idempotency_key,
  "task_id": $task_id,
  "event_type": "grounded.search",
  "provider": "google",
  "measurements": {
    "input_tokens": $response["usageMetadata"]["promptTokenCount"]
  },
  "provider_response_cost_micros": to_micros($response["usageMetadata"]["totalCost"], "major_units_decimal", "usd"),
  "currency": "usd"
}
