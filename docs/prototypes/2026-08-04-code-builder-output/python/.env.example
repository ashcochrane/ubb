# Generated by the UBB Code Builder alongside ubb_integration.py.
#
# Every value here is deliberately empty. No file this builder produces ever
# contains a real credential, including this one — copy it to `.env`, fill it in
# there, and keep `.env` out of version control.
#
# Where to get these: Developers -> API Keys.

# Your UBB API key. A sandbox key starts ubb_test_ and bills nobody; a live key
# starts ubb_live_. verify_integration.py refuses to run without a sandbox key.
UBB_API_KEY=

# Not a credential — the API host. The generated code already defaults to
# https://api.ubb.dev, so set this only to point somewhere else.
UBB_BASE_URL=

# Used by verify_integration.py only.
UBB_VERIFY_CUSTOMER_ID=

# Your provider credentials are not listed here. Nothing this builder generates
# calls your provider: the generated code takes the response you already have.
