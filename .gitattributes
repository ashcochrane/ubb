# The committed OpenAPI document is byte-compared by the drift gate and the
# in-suite drift pin — keep it LF on every platform.
openapi/v1.json text eol=lf

# The generated SDK core and its siblings ride the same ratchet (issue #84):
# CI regenerates and byte-compares them, so they must be LF in the working tree
# on every platform, whatever a contributor's core.autocrlf is.
ubb-sdk/ubb/_core/** text eol=lf
ubb-sdk/ubb/_exceptions_generated.py text eol=lf
ubb-sdk/ubb/_spec_revision.py text eol=lf

# The vocabulary registry is the input every generated vocabulary artifact is
# byte-compared against (#200, #207, #208). Pin it to LF now, before anything
# rides a zero-diff gate off it, so a contributor's core.autocrlf can never
# become the reason a regeneration check disagrees.
domain-vocabulary/** text eol=lf

# ...and the output. The generated backend constants (#200) and the console and
# SDK artifacts beside them (#207) are byte-compared by
# tests/contracts/test_generated_vocabulary.py against what the generator
# writes, which is LF on every platform. Without this pin, a checkout with
# core.autocrlf set turns the working copy into CRLF and the gate goes red for
# a reason that has nothing to do with the vocabulary.
#
# All three are listed by name rather than matched by a pattern: they live in
# three different subtrees under three different toolchains, and a pattern wide
# enough to catch them would catch hand-written neighbours too.
ubb-platform/core/vocabulary.py text eol=lf
apps/ui/src/lib/vocabulary.ts text eol=lf
ubb-sdk/ubb/vocabulary.py text eol=lf

# The SDK's coverage manifest (#204), for exactly the same reason: it is
# generated from openapi/v1.json and ubb-sdk/ubb/, and byte-compared by
# tests/contracts/test_sdk_operations.py and the `--write` step in CI. Its
# authorisations file is hand-authored and only ever parsed as YAML, so it needs
# no pin — this list is for what a gate compares byte for byte.
ubb-sdk/operation-coverage.yaml text eol=lf
